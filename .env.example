# Copy to .env and fill in. Never commit .env.

# Etherscan API V2 — one key for all EVM chains. Free tier (checked 2026-09-30): Ethereum,
# Polygon, Arbitrum. https://etherscan.io/apis
ETHERSCAN_API_KEY=
# Set to 1 if the key's plan covers BNB Chain, Base, OP Mainnet and Avalanche too.
# ETHERSCAN_PAID=1

# EVM chains not covered by the Etherscan plan are traced without a key by a window-limited
# JSON-RPC log scan of verified tokens (ADR-0021). Such cases need the incident time (`since`).
# Built-in public defaults exist for bsc, polygon, arbitrum, base, optimism, avalanche;
# override or add any chain with ANVESHAK_RPC_<CHAIN> (an archive endpoint for old incidents).
# A provider URL with the key in it (e.g. .../v3/<key>) is fine: the key is redacted before
# anything is recorded (ADR-0025).
# ANVESHAK_RPC_BSC=https://bsc-rpc.publicnode.com
# ANVESHAK_RPC_ETHEREUM=https://rpc.mevblocker.io    # served historical eth_getLogs on 2026-10-04
# ANVESHAK_LOGSCAN_HOURS=72

# Optional: TronGrid works without a key but is heavily rate-limited. https://www.trongrid.io/
TRONGRID_API_KEY=

# Solana JSON-RPC. The public endpoint works but is heavily rate-limited; a provider URL
# (e.g. Helius, Triton) is recommended for real cases.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_MAX_SIGNATURES=300

# Optional overrides
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# TRONGRID_BASE_URL=https://api.trongrid.io
# ESPLORA_BASE_URL=https://blockstream.info/api

# Cross-chain resolvers to use (ADR-0022).
# ANVESHAK_RESOLVERS=thorchain,wormhole,layerzero,across

# Where evidence objects, the case database and reports are written.
# ANVESHAK_VAR_DIR=var

# API access (ADR-0023). Preferred: per-client keys with roles and agency scope, created with
#   anveshak clients add --client-id sahyog-portal --role sahyog --ip 10.20.0.0/16
# which writes <var>/api_clients.yaml (or the file named here).
# ANVESHAK_API_CLIENTS_FILE=var/api_clients.yaml
# Legacy single key (becomes one admin client). With neither, the API is open — development only.
# ANVESHAK_API_TOKEN=
# Request bodies larger than this are rejected with 413.
# ANVESHAK_MAX_BODY_BYTES=1048576

# Sahyog callbacks (ADR-0019): sent only to these hosts, over https (plain http only for a
# loopback test receiver), signed with HMAC-SHA256 using this secret.
# ANVESHAK_CALLBACK_ALLOWLIST=sahyog.gov.in
# ANVESHAK_CALLBACK_SECRET=

# Approvals happen in Sahyog. Enable Anveshak's own approve endpoint only for standalone pilots.
# ANVESHAK_STANDALONE_APPROVALS=1

# Blockchain-intelligence API providers (optional). Their answers are stored as evidence
# and graded like any other label.
# CHAINALYSIS_API_KEY=            # free sanctions-screening API key
# ETHERSCAN_NAMETAGS=1            # requires Etherscan Pro Plus

# EVM chains probed when a reported 0x address arrives without a chain (Sahyog ingestion).
# ANVESHAK_EVM_CHAINS=ethereum,polygon,arbitrum,bsc

# Queue a follow-up trace automatically when watched funds move.
# ANVESHAK_AUTO_FOLLOW_UP=1

# Watchlist monitor interval (seconds) and number of in-process case workers.
# ANVESHAK_MONITOR_INTERVAL=600
# ANVESHAK_EMBEDDED_WORKERS=2
