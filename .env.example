# Copy to .env and fill in. Never commit .env.

# Etherscan API V2 — one key for all EVM chains. Free tier (checked 2026-09-30): Ethereum,
# Polygon, Arbitrum. BNB Chain, Base, OP Mainnet and Avalanche need a paid plan or an
# Etherscan-compatible provider set via ETHERSCAN_BASE_URL. https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional: TronGrid works without a key but is heavily rate-limited. https://www.trongrid.io/
TRONGRID_API_KEY=

# Solana JSON-RPC. The public endpoint works but is heavily rate-limited; a provider URL
# (e.g. Helius, Triton) is recommended for real cases.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_MAX_SIGNATURES=300

# Optional overrides
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# TRONGRID_BASE_URL=https://api.trongrid.io
# ESPLORA_BASE_URL=https://blockstream.info/api

# Where evidence objects, the case database and reports are written.
# ANVESHAK_VAR_DIR=var

# If set, the HTTP API requires header `X-API-Key: <value>` (used by the Sahyog gateway).
# ANVESHAK_API_TOKEN=

# Blockchain-intelligence API providers (optional). Their answers are stored as evidence
# and graded like any other label.
# CHAINALYSIS_API_KEY=            # free sanctions-screening API key
# ETHERSCAN_NAMETAGS=1            # requires Etherscan Pro Plus

# EVM chains probed when a reported 0x address arrives without a chain (Sahyog ingestion).
# ANVESHAK_EVM_CHAINS=ethereum,polygon,arbitrum,bsc

# Queue a follow-up trace automatically when watched funds move.
# ANVESHAK_AUTO_FOLLOW_UP=1

# Sahyog webhook callbacks are only sent to these hosts (comma-separated). Empty = disabled.
# ANVESHAK_CALLBACK_ALLOWLIST=sahyog.gov.in

# Watchlist monitor interval (seconds) and number of in-process case workers.
# ANVESHAK_MONITOR_INTERVAL=600
# ANVESHAK_EMBEDDED_WORKERS=2
