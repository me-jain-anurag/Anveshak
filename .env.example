# Copy to .env and fill in. Never commit .env.

# Etherscan API V2 (one key for Ethereum + Polygon on the free tier; BSC needs a paid plan
# or an Etherscan-compatible provider set via ETHERSCAN_BASE_URL). https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional: TronGrid works without a key but is heavily rate-limited. https://www.trongrid.io/
TRONGRID_API_KEY=

# Optional overrides
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# TRONGRID_BASE_URL=https://api.trongrid.io
# ESPLORA_BASE_URL=https://blockstream.info/api

# Where evidence objects, the case database and reports are written.
# ANVESHAK_VAR_DIR=var

# If set, the HTTP API requires header `X-API-Key: <value>` (used by the Sahyog gateway).
# ANVESHAK_API_TOKEN=
